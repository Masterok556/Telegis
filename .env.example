# Copy to .env. Never commit or share the real key.
# Default: OpenRouter. Add your own OpenRouter API key locally.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-terra
LLM_REASONING_EFFORT=none
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1200
# Some compatible providers do not support response_format=json_object.
LLM_JSON_MODE=true
# For a different provider/model, use its exact base URL and model ID.
# Leave LLM_REASONING_EFFORT empty if that provider/model does not support it.
# Exact origins only, comma separated; normally leave empty (same-origin UI).
CORS_ORIGINS=
